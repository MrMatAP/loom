# Copy to .env (gitignored) and fill in before `docker compose up`.

LOOM_DB_NAME=loom
LOOM_DB_USERNAME=loom
LOOM_DB_PASSWORD=change-me

# Your OIDC issuer -- Keycloak realm URL or equivalent. Must already have
# the loom-catalog-api client registered (see docs/admin-guide.md /
# `loom idp register-client`).
LOOM_AUTH_ISSUER=https://idp.example/realms/loom
LOOM_AUTH_AUDIENCE=loom-catalog-api

# Optional: pin to a specific built image instead of `loom:dev`.
# LOOM_IMAGE_TAG=1.4.2
