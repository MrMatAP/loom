# Copy to .env (gitignored) and fill in before `docker compose up`.
# LOOM_DB_HOST/LOOM_DB_PORT aren't needed here -- docker-compose.yaml wires
# the app container straight to the `postgres` service itself. They're only
# relevant outside compose (bare `docker run`/Kubernetes, see
# docs/admin-guide.md) or for the optional live-Postgres test suite below.

LOOM_DB_NAME=loom
LOOM_DB_USERNAME=loom
LOOM_DB_PASSWORD=change-me

# Your OIDC issuer -- Keycloak realm URL or equivalent. Must already have
# the loom-catalog-api client registered (see docs/admin-guide.md /
# `loom idp register-client`).
LOOM_AUTH_ISSUER=https://idp.example/realms/loom
LOOM_AUTH_AUDIENCE=loom-catalog-api
# LOOM_AUTH_JWKS_URI=              # derived from the issuer if unset
# LOOM_AUTH_DOCS_CLIENT_ID=        # only if exposing /docs (catalog-api only)
# LOOM_AUTH_CLI_CLIENT_ID=         # unused by the servers themselves

# Only if your IDP's CA isn't in the image's trust store.
# LOOM_IDP_CA_BUNDLE=/path/to/ca-bundle.pem

# Fallback admin credentials for `loom idp register-*` so it doesn't prompt
# interactively. See docs/admin-guide.md.
# LOOM_IDP_ADMIN_USERNAME=admin
# LOOM_IDP_ADMIN_PASSWORD=change-me

# Optional: pin to a specific built image instead of `loom:dev`.
# LOOM_IMAGE_TAG=1.4.2

# --- Live integration tests (`pytest tests/integration/ -m live_idp`) -----
# Deliberately separate from LOOM_AUTH_ISSUER/LOOM_IDP_ADMIN_* above: this
# suite runs admin-privileged setup/teardown against a real Keycloak
# instance and should point at a disposable test realm, not whatever
# realm LOOM_AUTH_ISSUER has you pointed at day-to-day. See
# README.md#live-idp-integration-tests.
# LOOM_IDP_ISSUER_URL=https://idp.example/realms/loom
# LOOM_IDP_ISSUER_ADMIN_USERNAME=admin
# LOOM_IDP_ISSUER_ADMIN_PASSWORD=change-me

# Optional: exercises tests/integration/ against a real Postgres instead of
# the in-memory sqlite used by the rest of the suite. Uses the same
# LOOM_DB_NAME/USERNAME/PASSWORD above; point LOOM_DB_HOST at a disposable
# test database, not production, since the suite creates/drops its own
# schema objects there (see `tests/integration/live_db.py`).
# LOOM_DB_HOST=localhost
